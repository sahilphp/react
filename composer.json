{
    "name": "sahilphp/react",
    "description": "A complete SahilPHP starter-kit with a React and TypeScript frontend.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "sahilphp",
        "starter-kit",
        "react",
        "typescript",
        "vite"
    ],
    "require": {
        "php": ">=8.2",
        "sahilphp/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "@php sahil start",
        "test": "phpunit --configuration phpunit.xml --colors=always",
        "test:js": "npm test",
        "check": "npm run check",
        "build": "npm run build"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
