{
    "name": "sahilphp-starter-kit-react",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "SahilPHP starter-kit for React 19 and TypeScript",
    "license": "MIT",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev": "vite",
