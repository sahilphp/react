{
    "name": "sahilphp/react",
    "description": "React UI integration for SahilPHP applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sahilphp",
        "react",
        "typescript",
        "vite"
    ],
    "homepage": "https://github.com/sahilphp/react",
    "support": {
        "issues": "https://github.com/sahilphp/react/issues",
        "source": "https://github.com/sahilphp/react"
    },
    "require": {
        "php": ">=8.3",
        "sahilphp/framework": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --colors=always",
        "post-create-project-cmd": [
            "@php scripts/refuse-create-project.php"
        ],
        "test:js": "npm test",
        "check": "npm run check",
        "build": "npm run build"
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.git",
            "/.github",
            "/.phpunit.cache",
            "/composer.lock",
            "/node_modules",
            "/package-lock.json",
            "/tests",
            "/vendor"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
